# Supabase connection string (Settings -> Database -> Connection string -> URI)
# Use the "Transaction" pooler connection string on port 6543 for serverless (Vercel)
DATABASE_URL=postgresql://postgres.xxxxxxxx:[email protected]:6543/postgres

# Secret used to sign JWTs (generate a long random string)
JWT_SECRET=replace_with_a_long_random_secret

# Comma-separated list of allowed origins for CORS (e.g. your app scheme, or * during dev)
ALLOWED_ORIGINS=*

# Optional: Stripe secret key for verifying subscription payment webhooks
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
